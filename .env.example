# gateway-edge/.env.example — template (committed)
# Copy to .env.dev for local secret overrides:  cp .env.example .env.dev

JWT_SECRET=CHANGE_ME_must_match_dev_JWT_SECRET
GATEWAY_REGION=GLOBAL

# Sidecar polls control-plane and writes GATEWAY_CONFIG_PATH (bundled in this image).
CONTROL_PLANE_URL=http://control-plane:8081
GATEWAY_CONFIG_PATH=/etc/gateway/config.json
CONFIG_POLL_SECS=5
CONFIG_READ_TOKEN=
# Render: set METRICS_PORT=0 (or METRICS_BIND=127.0.0.1) so port 9092 is not picked as the web port.
# METRICS_PORT=0
# METRICS_BIND=127.0.0.1

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REVOCATION_FAIL_CLOSED=1
GATEWAY_REFUSE_INSECURE_SECRETS=1
AUTH_CACHE_TTL_SECS=30

TLS_ENABLED=false
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key

LOG_LEVEL=warn
FALLBACK_REGION=US
