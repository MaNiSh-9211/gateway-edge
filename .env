# gateway-edge/.env — committed safe defaults (public repo)
# Secrets → gateway-edge/.env.dev (gitignored) | shared secrets → dev/.env.dev

JWT_SECRET=super_secret_key_for_hmac_sha256_change_in_prod
GATEWAY_REGION=GLOBAL

CONTROL_PLANE_URL=http://control-plane:8081
GATEWAY_CONFIG_PATH=/etc/gateway/config.json
CONFIG_POLL_INTERVAL_SECS=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REVOCATION_FAIL_CLOSED=0
AUTH_CACHE_TTL_SECS=30

TLS_ENABLED=false
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key

LOG_LEVEL=warn
FALLBACK_REGION=US
